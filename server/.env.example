# ─── Server ───
PORT=5000
NODE_ENV=development

# ─── PostgreSQL ───
DB_HOST=localhost
DB_PORT=5432
DB_NAME=portal_advokasi
DB_USER=postgres
DB_PASSWORD=your_password_here

# ─── JWT (untuk admin auth nanti) ───
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# ─── Rate Limit ───
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─── CORS ───
CORS_ORIGIN=http://localhost:5173
